<script>
	let section = "game";
	let game_names = ["intro", "single", "word", "challenge", "sentence", "story"];
	let game_num = game_names.indexOf("single");
	let sound_name = "d";

	let game = '{"sounds": {' +
		'"b":{"qno": [0,10,10,5,10,7], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"d":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"g":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"gw":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"j":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-k":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"kw":{"qno": [0,10,10,5,10,7], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"l":{"qno": [0,10,10,5,10,8], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"m":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"n":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-n":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"ng":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-ng":{"qno": [0,10,10,5,10,9], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-p":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"t":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-t":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"c":{"qno": [0,15,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"f":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"h":{"qno": [0,15,10,5,10,4], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"k":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"-m":{"qno": [0,10,10,5,10,9], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"p":{"qno": [0,10,10,5,10,5], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"s":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]},' +
		'"z":{"qno": [0,10,10,5,10,6], "type": ["mp4","jpg","png","jpg","png","png"]}' +
		'}}';

	const game_obj = JSON.parse(game);
	var number_pics = game_obj["sounds"][sound_name]["qno"][game_num];
	var file_type = game_obj["sounds"][sound_name]["type"][game_num];

	var cur_index = 1;
	var max_index = number_pics;
</script>

<section>

	<div class="container" style="position: relative;">
		<div class="text-center mb-3"><div class="btn btn-lg btn-warning fs-3">d</div></div>
					<div class="row justify-content-center">
				<div class="col-12 text-center"><img id="imgGame" src="" /></div>
				<div class="col-12 text-center mt-3"><a href="javascript:playSound();"><img id="btnAudio" src="/assets/images/btnPlay.png" /></a></div>
				<audio id="auControl">
					<source id="auSource" src="" type="audio/mpeg">
					Your browser does not support the audio element.
				</audio>
			</div>

			<a class="gloss-control left" href="javascript:changeQ(cur_index-1);" alt="Prev" title="Prev">
				<i class="fa fa-angle-left"></i>
				<span class="sr-only">Previous</span>
			</a>

			<a class="gloss-control right" href="javascript:changeQ(cur_index+1);" alt="Next" title="Next">
				<i class="fa fa-angle-right"></i>
				<span class="sr-only">Next</span>
			</a>
		
		<div class="row justify-content-center mt-3 mb-7">
			<div class="col-12 text-center">
				<a href="/tc/sound/d" class="btn-back">返回</a>
			</div>
		</div>

	</div>
</section>

<script>
	function changeQ(qno) {

		loadImage("/assets/pics/" + sound_name + "/" + game_num + "-" + qno + "." + file_type);
		loadAudio("/assets/voices/" + sound_name + "/" + game_num + "-" + qno + ".mp3")
		window.cur_index = qno;

		if (window.cur_index == 1) {
			$(".gloss-control.left").addClass("disabled");
		} else {
			$(".gloss-control.left").removeClass("disabled");
		}

		if (window.cur_index == max_index) {
			$(".gloss-control.right").addClass("disabled");
		} else {
			$(".gloss-control.right").removeClass("disabled");
		}
	}

	function playSound() {
		var au = document.getElementById("auControl");
		au.play();
	}
</script>			<section class="background-footer text-center py-4 footer">
