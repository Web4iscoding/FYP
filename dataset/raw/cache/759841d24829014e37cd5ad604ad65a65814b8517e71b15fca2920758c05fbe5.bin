		<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>


		<script>
			$(document).ready(function() {
				if (section == "game" && game_num != 0) {
					loadImage("/assets/pics/" + sound_name + "/" + game_num + "-" + cur_index + "." + file_type);
					loadAudio("/assets/voices/" + sound_name + "/" + game_num + "-" + cur_index + ".mp3");

					if (cur_index == 1) {
						$(".gloss-control.left").addClass("disabled");
					}

					if (cur_index == max_index) {
						$(".gloss-control.right").addClass("disabled");
					}
				}

				if (section == "book") {
					loadImage("/assets/books/" + book_id + "/" + cur_index + ".jpg");
					loadAudio("/assets/books/" + book_id + "/" + cur_index + ".mp3");
					loadAudios("/assets/books/" + book_id + "/" + cur_index + "s.mp3");

					if (cur_index == 0) {
						$(".gloss-control.left").addClass("disabled");
					}

					if (cur_index == max_index) {
						$(".gloss-control.right").addClass("disabled");
					}
				}

			});

			function loadImage(path) {
				$("#imgGame").attr("src", path);
			}

			function loadAudio(path) {
				var au = document.getElementById('auControl');
				var source = document.getElementById('auSource');
				source.src = path;
				au.load(); //call this to just preload the audio without playing
			}

			function loadAudios(path) {
				var au = document.getElementById('auControls');
				var source = document.getElementById('auSources');
				source.src = path;
				au.load(); //call this to just preload the audio without playing
			}


			function changeSection(section) {
				if (section == 1) {
					$("#divSound").removeClass("d-none");
					$("#divBook").addClass("d-none");
				} else if (section == 2) {

					$("#divSound").addClass("d-none");
					$("#divBook").removeClass("d-none");
				}
			}
		</script></body></html>